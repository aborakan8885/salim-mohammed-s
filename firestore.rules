rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public creation of feedback
    match /feedbacks/{feedbackId} {
      allow create: if true;
      allow read, delete: if request.auth != null; // Simple check for now, can be refined
    }
    
    // Default deny
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
